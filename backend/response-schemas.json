  "components": {
    "schemas": {
      "ApprovalResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "revision_no": {
            "type": "integer",
            "title": "Revision No"
          },
          "bound_state_hash": {
            "type": "string",
            "title": "Bound State Hash"
          },
          "frozen_dispatch_payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Frozen Dispatch Payload"
          },
          "reviewer_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer Id"
          },
          "reviewer_signature": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer Signature"
          },
          "reviewer_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer Note"
          },
          "status": {
            "$ref": "#/components/schemas/ApprovalStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "decided_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "run_id",
          "revision_no",
          "bound_state_hash",
          "frozen_dispatch_payload",
          "reviewer_id",
          "reviewer_signature",
          "reviewer_note",
          "status",
          "created_at",
          "decided_at"
        ],
        "title": "ApprovalResponse"
      },
      "ApprovalStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "APPROVED",
          "CONSUMED_FOR_DISPATCH",
          "REJECTED",
          "INVALIDATED_STALE"
        ],
        "title": "ApprovalStatus"
      },
      "ApproveRunRequest": {
        "properties": {
          "reviewer_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Reviewer Id"
          },
          "bound_revision_no": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Bound Revision No"
          },
          "bound_state_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Bound State Hash"
          },
          "reviewer_note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer Note"
          },
          "auto_execute_dispatch": {
            "type": "boolean",
            "title": "Auto Execute Dispatch",
            "default": true
          },
          "chaos_config": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChaosConfig"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reviewer_id",
          "bound_revision_no",
          "bound_state_hash"
        ],
        "title": "ApproveRunRequest"
      },
      "AttemptResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "step_id": {
            "type": "string",
            "title": "Step Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "attempt_no": {
            "type": "integer",
            "title": "Attempt No"
          },
          "event": {
            "type": "string",
            "title": "Event"
          },
          "evidence": {
            "additionalProperties": true,
            "type": "object",
            "title": "Evidence"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "run_id",
          "step_id",
          "kind",
          "attempt_no",
          "event",
          "evidence",
          "created_at"
        ],
        "title": "AttemptResponse"
      },
      "BenchmarkMetric": {
        "properties": {
          "cohort": {
            "type": "string",
            "title": "Cohort"
          },
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "denominator": {
            "type": "integer",
            "title": "Denominator"
          },
          "saga": {
            "type": "integer",
            "title": "Saga"
          },
          "naive": {
            "type": "integer",
            "title": "Naive"
          }
        },
        "type": "object",
        "required": [
          "cohort",
          "metric",
          "denominator",
          "saga",
          "naive"
        ],
        "title": "BenchmarkMetric"
      },
      "BenchmarkResponse": {
        "properties": {
          "seed": {
            "type": "integer",
            "title": "Seed"
          },
          "cases_per_runner": {
            "type": "integer",
            "title": "Cases Per Runner"
          },
          "total_executions": {
            "type": "integer",
            "title": "Total Executions"
          },
          "metrics": {
            "items": {
              "$ref": "#/components/schemas/BenchmarkMetric"
            },
            "type": "array",
            "title": "Metrics"
          }
        },
        "type": "object",
        "required": [
          "seed",
          "cases_per_runner",
          "total_executions",
          "metrics"
        ],
        "title": "BenchmarkResponse"
      },
      "ChaosConfig": {
        "properties": {
          "drop_response_after_write_on_step": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Drop Response After Write On Step"
          },
          "crash_worker_after_step_in_flight": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Crash Worker After Step In Flight"
          },
          "crash_after_external_commit_on_step": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Crash After External Commit On Step"
          },
          "transient_timeout_before_write_on_step": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Transient Timeout Before Write On Step"
          },
          "fail_compensation_on_step": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Fail Compensation On Step"
          },
          "crash_after_compensation_write_on_step": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Crash After Compensation Write On Step"
          },
          "drop_compensation_response_on_step": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Drop Compensation Response On Step"
          },
          "crash_after_dispatch_claim": {
            "type": "boolean",
            "title": "Crash After Dispatch Claim",
            "default": false
          },
          "keep_verification_unknown": {
            "type": "boolean",
            "title": "Keep Verification Unknown",
            "default": false
          },
          "fail_finalization_once": {
            "type": "boolean",
            "title": "Fail Finalization Once",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ChaosConfig"
      },
      "ChaosScenarioRequest": {
        "properties": {
          "chaos_config": {
            "$ref": "#/components/schemas/ChaosConfig"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ChaosScenarioRequest"
      },
      "CompensationStatus": {
        "type": "string",
        "enum": [
          "NOT_NEEDED",
          "PENDING",
          "IN_FLIGHT",
          "OUTCOME_UNKNOWN",
          "COMPENSATED",
          "COMPENSATION_FAILED"
        ],
        "title": "CompensationStatus"
      },
      "CreateRunRequest": {
        "properties": {
          "scenario_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario Id"
          },
          "customer_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Customer Name"
          },
          "customer_email": {
            "type": "string",
            "maxLength": 320,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
